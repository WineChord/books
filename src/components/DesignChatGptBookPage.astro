  <script>
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-design-nav]"));
    const sections = links
      .map((link) => document.getElementById(link.dataset.designNav ?? ""))
      .filter((section): section is HTMLElement => section instanceof HTMLElement);

    const getScrollOffset = () => {
      const raw = window.getComputedStyle(document.documentElement).scrollPaddingTop;
      const parsed = Number.parseFloat(raw);
      return Number.isFinite(parsed) ? parsed : 128;
    };

    const getSectionMargin = () => {
      const sample = sections[0];
      if (!sample) return 0;
      const raw = window.getComputedStyle(sample).scrollMarginTop;
      const parsed = Number.parseFloat(raw);
      return Number.isFinite(parsed) ? parsed : 0;
    };

    const setActive = (id: string) => {
      links.forEach((link) => {
        link.classList.toggle("is-active", link.dataset.designNav === id);
      });
    };

    const updateActiveFromScroll = () => {
      const activationY = getScrollOffset() + getSectionMargin() + 32;
      const current = sections.reduce<HTMLElement | null>((active, section) => {
        if (section.getBoundingClientRect().top <= activationY) return section;
        return active;
      }, sections[0] ?? null);
      if (current) setActive(current.id);
    };

    let ticking = false;
    const queueActiveUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        ticking = false;
        updateActiveFromScroll();
      });
    };

    const scrollToHash = () => {
      if (!window.location.hash) return;
      const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
      if (!(target instanceof HTMLElement)) return;
      target.scrollIntoView({ block: "start" });
      setActive(target.id);
      window.setTimeout(() => setActive(target.id), 0);
      window.setTimeout(() => setActive(target.id), 180);
    };

    const stabilizeHashScroll = () => {
      if (!window.location.hash) {
        updateActiveFromScroll();
        return;
      }
      [0, 80, 260, 700].forEach((delay) => window.setTimeout(scrollToHash, delay));
      if ("fonts" in document) {
        document.fonts.ready.then(scrollToHash).catch(() => {});
      }
    };

    links.forEach((link) => {
      link.addEventListener("click", (event) => {
        const id = link.dataset.designNav;
        if (!id) return;
        event.preventDefault();
        history.pushState(null, "", `#${id}`);
        scrollToHash();
      });
    });

    window.addEventListener("scroll", queueActiveUpdate, { passive: true });
    window.addEventListener("resize", queueActiveUpdate);
    window.addEventListener("hashchange", stabilizeHashScroll);
    window.addEventListener("load", stabilizeHashScroll);
    stabilizeHashScroll();
  </script>
