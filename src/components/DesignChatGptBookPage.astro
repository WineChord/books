    opacity: 0.78;
  }

  .interview-answer-map span,
  .interview-answer-map strong {
    display: block;
    overflow-wrap: anywhere;
  }

  .interview-answer-map span {
    color: currentColor;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0;
    text-transform: none;
  }

  .interview-answer-map strong {
    margin-top: 0.5rem;
    color: var(--color-charcoal);
    font-size: 0.88rem;
    line-height: 1.32;
  }

  .interview-answer-map__header strong {
    color: var(--color-secondary);
    font-size: 0.8rem;
  }

  .source-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .source-links a {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.45rem 0.75rem;
    color: var(--color-secondary);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .source-links--compact {
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .source-links--compact a {
    display: grid;
    gap: 0.12rem;
    border-radius: 0.5rem;
    padding: 0.52rem 0.65rem;
  }

  .source-links--compact strong {
    color: var(--color-charcoal);
    font-size: 0.82rem;
    line-height: 1.2;
  }

  .source-links--compact span {
    color: var(--color-secondary);
    font-size: 0.74rem;
    line-height: 1.25;
  }

  .source-links a:hover {
    border-color: var(--color-terracotta);
    color: var(--color-terracotta);
  }

  .source-group-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .source-group {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.78);
    padding: 1rem;
  }

  .source-group h3 {
    color: var(--color-charcoal);
    font-size: 1rem;
    letter-spacing: 0;
    margin: 0 0 0.35rem;
  }

  .source-group p {
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 0 0 0.8rem;
  }

  .source-group__links {
    display: grid;
    gap: 0.65rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .source-group__links li {
    border-top: 1px solid rgba(35, 44, 55, 0.1);
    padding-top: 0.65rem;
  }

  .source-group__links a {
    color: var(--color-secondary);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .source-group__links a:hover {
    color: var(--color-terracotta);
  }

  .source-group__links span {
    color: var(--color-muted);
    display: block;
    font-size: 0.84rem;
    line-height: 1.55;
    margin-top: 0.2rem;
  }

