  @media (max-width: 1180px) {
    :global(html) {
      scroll-padding-top: 8.25rem;
    }

    .design-page {
      grid-template-columns: 1fr;
      padding-top: 6.5rem;
    }

    .design-sidebar {
      position: fixed;
      top: 2.25rem;
      right: 0;
      left: 0;
      order: 1;
      z-index: 30;
      width: auto;
      padding: 0.5rem 1rem;
    }

    .design-sidebar__inner {
      display: flex;
      width: 100%;
      box-sizing: border-box;
      max-height: none;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      background: rgb(255 253 247 / 92%);
      box-shadow: 0 10px 28px rgb(20 20 19 / 7%);
    }

    .design-sidebar__spec,
    .design-sidebar__link {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .design-content {
      grid-column: 1;
      order: 2;
    }

    .capacity-funnel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .capacity-funnel__caption {
      display: grid;
    }

    .capacity-funnel__step:not(:last-child)::after {
      display: none;
    }

    .capacity-funnel__step--business,
    .capacity-funnel__step--entry,
    .capacity-funnel__step--token,
    .capacity-funnel__step--serving,
    .capacity-funnel__step--durable,
    .resource-dimension-map__step {
      grid-column: auto;
      grid-row: auto;
    }

    .requirements-visual-grid {
      grid-template-columns: 1fr;
    }

    .product-surface-map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .design-answer-contract {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 0;
    }

    .design-hero,
    .design-section {
      scroll-margin-top: 7.5rem;
    }

    .design-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }
  }

  @media (max-width: 860px) {
    .design-page {
      padding: 6.25rem 1rem 3rem;
    }

    .design-hero h1 {
      font-size: 2.8rem;
    }

    .design-hero__visual {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.65rem;
      height: auto;
      padding: 0.85rem;
    }

    .design-answer-contract {
      grid-template-columns: 1fr;
    }

    .hero-map-lines {
      display: none;
    }

    .question-route-map {
      display: grid;
      gap: 0.65rem;
      min-height: 0;
      padding: 0.85rem;
    }

    .question-route-map svg {
      display: none;
    }

    .capacity-funnel {
      grid-template-columns: 1fr;
    }

    .route-root,
    .route-decision,
    .route-branch,
    .route-default,
    .slo-triangle__corner,
    .slo-triangle__core {
      position: static;
      width: auto;
      min-height: 0;
      transform: none;
    }

    .hero-boundary-grid {
      grid-template-columns: 1fr;
    }

    .hero-map-pill,
    .hero-node,
    .hero-extension,
    .hero-plane {
      position: static;
      grid-column: auto;
      grid-row: auto;
      width: auto;
      min-width: 0;
      min-height: 0;
    }

    .hero-node::before,
    .hero-node::after,
    .hero-extension::before,
    .hero-extension::after {
      display: none;
    }

    .hero-map-pill {
      border-radius: 0.5rem;
      text-align: left;
    }

    .hero-node {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
