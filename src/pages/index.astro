---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import {
  ccBook,
  codexContextManagementBook,
  codexFromSourceBook,
  designBook,
  iqBook,
  lcpBook,
  leetcodeBook,
  suffixArrayBook,
} from "../book.config";
import { assetUrl, pageUrl } from "../urls";

const base = import.meta.env.BASE_URL;
const spotlightImage = assetUrl(
  base,
  `${codexContextManagementBook.slug}/assets/cover-codex-context-management.png`,
);

const libraryBooks = [
  codexContextManagementBook,
  leetcodeBook,
  codexFromSourceBook,
  designBook,
  ccBook,
  iqBook,
  suffixArrayBook,
  lcpBook,
];

const readingTracks = [
  {
    title: "Prompt Cache and Context Budget",
    label: "Featured path",
    href: pageUrl(base, `${codexContextManagementBook.slug}/chapter-05`),
    body:
      "Start from optional context, prompt assembly, typed fragments, and the budget discipline behind long-running agent work.",
  },
  {
    title: leetcodeBook.title,
    label: "Practice track",
    href: pageUrl(base, `${leetcodeBook.slug}/`),
    body:
      "Use the frequency table, company buckets, local marks, and submit helper when the goal is repeated coding practice.",
  },
  {
    title: codexFromSourceBook.title,
    label: "Source track",
    href: pageUrl(base, `${codexFromSourceBook.slug}/`),
    body:
      "Read the full runtime map when you want tools, sandboxing, app-server, plugins, and multi-agent work tied back to code.",
  },
];

const articleLinks = [
  {
    title: "AI Agent Readlist",
    label: "Research map",
    href: pageUrl(base, "ai-agent-readlist/"),
    body:
      "A curated route through context management, multi-agent systems, sandboxing, self-evolution, harness engineering, and evaluation.",
  },
  {
    title: "DeepSeek V4 Interview Notes",
    label: "Model systems",
    href: pageUrl(base, "deepseek/"),
    body:
      "A systems-oriented interview note for million-token context, hybrid attention, MoE, evaluation, serving, and cache tradeoffs.",
  },
];
---

<BaseLayout
  title="WineChord Books"
  titleSuffix="WineChord Books"
  description="A curated shelf of WineChord engineering books and long-form technical notes."
  canonicalPath=""
  image={spotlightImage}
>
  <Header
    alternatePath={null}
    homePath=""
    brandTitle="WineChord Books"
    brandShortTitle="Books"
  />
  <main class="books-index mx-auto max-w-6xl px-4 py-10 md:px-8 md:py-16">
    <section
      class="books-index-hero"
      style={`--books-hero-image: url("${spotlightImage}")`}
      aria-labelledby="books-index-title"
    >
      <div class="books-index-hero__copy">
        <p class="books-index-kicker">WineChord Books</p>
        <h1 id="books-index-title">Long-form engineering notes, organized as books.</h1>
        <p>
          Source reading, agent runtime, coding practice, system design, and interview
          preparation live here as structured pages instead of scattered posts.
        </p>
        <div class="books-index-actions">
          <a class="books-index-button books-index-button--primary" href={pageUrl(base, `${codexContextManagementBook.slug}/`)}>
            Start with context
          </a>
          <a class="books-index-button" href={pageUrl(base, `${leetcodeBook.slug}/`)}>
            Open LeetCode 888
          </a>
        </div>
      </div>
    </section>

    <section class="books-index-section" aria-labelledby="books-index-tracks-title">
      <div class="books-index-section__head">
        <p class="books-index-kicker">Start Here</p>
        <h2 id="books-index-tracks-title">Good first paths</h2>
      </div>
      <div class="books-index-tracks">
        {readingTracks.map((track, index) => (
          <a class={`books-index-track ${index === 0 ? "books-index-track--primary" : ""}`} href={track.href}>
            <span class="books-index-track__label">{track.label}</span>
            <strong>{track.title}</strong>
            <span>{track.body}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="books-index-section" aria-labelledby="books-index-library-title">
      <div class="books-index-section__head books-index-section__head--split">
        <div>
          <p class="books-index-kicker">Library</p>
          <h2 id="books-index-library-title">All current books</h2>
        </div>
        <a class="books-index-link" href="https://github.com/WineChord/books" target="_blank" rel="noopener noreferrer">
          GitHub repository
        </a>
      </div>
      <div class="books-index-library">
        {libraryBooks.map((book, index) => (
          <a class={`books-index-book ${index === 0 ? "books-index-book--featured" : ""}`} href={pageUrl(base, `${book.slug}/`)}>
            <span class="books-index-book__number">{String(index + 1).padStart(2, "0")}</span>
            <span class="books-index-book__kicker">{book.coverKicker}</span>
            <strong>{book.title}</strong>
            <span class="books-index-book__zh">{book.zhTitle}</span>
            <span class="books-index-book__body">{book.description}</span>
            <span class="books-index-book__footer">{book.coverFooter}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="books-index-section books-index-section--compact" aria-labelledby="books-index-articles-title">
      <div class="books-index-section__head">
        <p class="books-index-kicker">Articles</p>
        <h2 id="books-index-articles-title">Long notes outside the shelf</h2>
      </div>
      <div class="books-index-articles">
        {articleLinks.map((article) => (
          <a class="books-index-article" href={article.href}>
            <span>{article.label}</span>
            <strong>{article.title}</strong>
            <small>{article.body}</small>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
